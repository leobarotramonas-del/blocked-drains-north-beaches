{
  "name": "antons-blocked-drains-northern-beaches",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4335",
    "build": "astro check && astro build && node scripts/check-site.mjs && npm run check:blog-images && npm run check:video-dates && npm run check:organization",
    "preview": "astro preview --host 127.0.0.1 --port 4335",
    "check": "astro check",
    "check:site": "node scripts/check-site.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "capture": "node scripts/capture.mjs",
    "media": "node scripts/prepare-media.mjs",
    "check:blog-images": "node scripts/check-blog-images.mjs",
    "check:video-dates": "node scripts/check-video-dates.mjs",
    "check:organization": "node scripts/check-organization-schema.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@fontsource/barlow": "^5.2.6",
    "@fontsource/saira-extra-condensed": "^5.2.6",
    "astro": "^7.3.8",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5"
  }
}
