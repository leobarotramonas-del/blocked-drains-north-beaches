---
import type { Faq } from '../data/site';
interface Props { items: Faq[]; title?: string }
const { items, title = 'A few answers before you call.' } = Astro.props;
---
<section class="section faq wrap"><h2>{title}</h2><div>{items.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></section>
