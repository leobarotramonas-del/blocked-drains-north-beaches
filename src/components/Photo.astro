---
import media from '../../docs/optimized-media.json';
interface Props { name: string; alt: string; eager?: boolean; class?: string; sizes?: string; }
const { name, alt, eager = false, class: className, sizes = '(max-width: 760px) 100vw, 50vw' } = Astro.props;
const variants = media.filter(image => image.photoId === name && image.file.endsWith('.webp'));
const avifVariants = [...new Map(media.filter(image => image.photoId === name && image.file.endsWith('.avif')).map(image => [image.width, image])).values()];
const uniqueWidths = [...new Map(variants.map(image => [image.width, image])).values()];
const fallback = variants.find(image => image.width === 800) || variants.at(-1);
if (!fallback) throw new Error(`Unknown photograph: ${name}`);
---
<picture style="display:contents">
<source type="image/avif" srcset={avifVariants.map(image => `${image.file.replace('public','')} ${image.width}w`).join(', ')} sizes={sizes} />
<img class={className} data-photo-id={name} src={fallback.file.replace('public','')} srcset={uniqueWidths.map(image => `${image.file.replace('public','')} ${image.width}w`).join(', ')} sizes={sizes} alt={alt} width={fallback.width} height={fallback.height} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
</picture>
