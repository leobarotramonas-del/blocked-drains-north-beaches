---
interface Props { name: string; alt: string; eager?: boolean; class?: string; sizes?: string; }
const { name, alt, eager = false, class: className, sizes = '(max-width: 760px) 100vw, 50vw' } = Astro.props;
---
<img class={className} src={`/images/${name}-800.webp`} srcset={[480,800,1200].map(w => `/images/${name}-${w}.webp ${w}w`).join(', ')} sizes={sizes} alt={alt} width="1200" height="1600" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
