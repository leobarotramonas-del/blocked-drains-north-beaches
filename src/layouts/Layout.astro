---
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/saira-extra-condensed/latin-700.css';
import displayFont from '@fontsource/saira-extra-condensed/files/saira-extra-condensed-latin-700-normal.woff2?url';
import bodyFont from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import '../styles/global.css';
import { site } from '../data/site';
import { areas } from '../data/areas';
import Faq from '../components/Faq.astro';
import { faqsForPage } from '../data/faqs';
interface Props { title: string; description: string; crumbs?: { name: string; href: string }[]; schema?: Record<string, unknown>[]; noindex?: boolean; article?: boolean; articleImage?: string; articleImageAlt?: string }
const { title, description, crumbs = [], schema = [], noindex = false, article = false, articleImage, articleImageAlt } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const pageFaqs = faqsForPage(pathname);
const canonical = new URL(pathname, site.url).href;
// Production is public unless explicitly disabled for a staging build.
const indexable = import.meta.env.PROD && import.meta.env.PUBLIC_ALLOW_INDEXING !== 'false' && !noindex;
const analyticsId = import.meta.env.PUBLIC_GA_ID || 'G-P1DMG58YXM';
const analytics = import.meta.env.PROD && /^G-[A-Z0-9]+$/.test(analyticsId) ? analyticsId : '';
const nav = [['Services','/services'],['Service areas','/service-areas'],['Our work','/our-work'],['Drain advice','/drain-advice'],['About','/about']];
const structured = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Plumber', '@id': `${site.url}/#business`, name: site.name, alternateName: site.operator, url: site.url, telephone: '+61493824176', image: `${site.url}/images/roots-1200.webp`, areaServed: areas.map(a => ({ '@type': 'Place', name: `${a.name}, NSW` })), hasCredential: { '@type': 'EducationalOccupationalCredential', name: `NSW contractor licence ${site.licence}`, credentialCategory: 'Contractor licence' }, openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'], opens: '00:00', closes: '23:59' }] },
  { '@type': 'WebSite', '@id': `${site.url}/#website`, name: site.name, url: site.url, publisher: { '@id': `${site.url}/#business` }, inLanguage: 'en-AU' },
  { '@type': 'WebPage', '@id': `${canonical}#page`, url: canonical, name: title, description, isPartOf: { '@id': `${site.url}/#website` }, about: { '@id': `${site.url}/#business` }, inLanguage: 'en-AU' },
  ...(crumbs.length ? [{ '@type': 'BreadcrumbList', itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c,i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, site.url).href })) }] : []),
  ...schema,
  ...(!article ? [{ '@type': 'FAQPage', '@id': `${canonical}#faqs`, mainEntity: pageFaqs.items.map(item => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) }] : []),
] };
---
<!doctype html>
<html lang="en-AU"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <meta name="robots" content={indexable ? 'index,follow,max-image-preview:large' : 'noindex,follow'} />
  <meta name="theme-color" content="#081939" />
  {!noindex && <link rel="canonical" href={canonical} />}
  <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <meta property="og:type" content={article ? "article" : "website"} /><meta property="og:locale" content="en_AU" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} /><meta property="og:site_name" content={site.name} />
  <meta property="og:image" content={articleImage ? new URL(articleImage, site.url).href : `${site.url}/images/roots-1200.webp`} />
  <meta property="og:image:alt" content={articleImageAlt ?? "Drain technician holding a root mass removed during drainage work"} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />
  {analytics && <script is:inline define:vars={{ analytics }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };

    let analyticsStarted = false;
    const engagementEvents = ['pointerdown', 'keydown', 'wheel', 'touchstart'];

    function startAnalytics() {
      if (analyticsStarted) return;
      analyticsStarted = true;

      window.gtag('js', new Date());
      window.gtag('config', analytics);

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(analytics)}`;
      document.head.append(script);

      engagementEvents.forEach(eventName => window.removeEventListener(eventName, startAnalytics));
    }

    engagementEvents.forEach(eventName => {
      window.addEventListener(eventName, startAnalytics, { once: true, passive: true });
    });

    document.addEventListener('click', event => {
      if (event.target.closest('a[href^="tel:"]')) {
        startAnalytics();
        window.gtag('event', 'phone_click', { page_location: location.href });
      }
    });
  </script>}
</head><body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="utility"><div class="wrap"><span>Northern Beaches drain specialists</span><span>NSW licence {site.licence}<span class="utility-hours"> · Urgent calls 24/7</span></span></div></div>
  <header><div class="wrap header-inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}><strong>ANTONS<span class="brand-mark" aria-hidden="true">/</span></strong><span>BLOCKED DRAINS<small>NORTH BEACHES</small></span></a>
    <nav class="desktop-nav" aria-label="Main navigation">{nav.map(([name,href]) => <a href={href} aria-current={pathname.startsWith(href) ? 'page' : undefined}>{name}</a>)}</nav>
    <a class="header-call" href={site.tel}><span>Speak to the team</span><strong>{site.phone}</strong></a>
    <details class="mobile-menu"><summary>Menu</summary><nav aria-label="Mobile navigation">{nav.map(([name,href]) => <a href={href}>{name}</a>)}<a href="/contact">Contact</a></nav></details>
  </div></header>
  <main id="main">{crumbs.length > 0 && <nav class="wrap breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a>{crumbs.map((c,i) => <><span aria-hidden="true">/</span>{i === crumbs.length-1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</>)}</nav>}<slot />{!article && <Faq items={pageFaqs.items} title={pageFaqs.title} />}</main>
  <footer><div class="wrap footer-top"><div><a class="brand" href="/"><strong>ANTONS<span class="brand-mark" aria-hidden="true">/</span></strong><span>BLOCKED DRAINS<small>NORTH BEACHES</small></span></a><p>Clear advice. Capable hands.<br />Drainage help across the Northern Beaches.</p><a class="footer-phone" href={site.tel}>{site.phone}</a></div><div><h2>Get Help</h2><a href="/services/emergency-blocked-drains">Urgent drain help</a><a href="/services">All drain services</a><a href="/service-areas">Find your suburb</a><a href="/contact">Contact the team</a></div><div><h2>Know Your Options</h2><a href="/our-work">Real drainage work</a><a class="footer-blog-link" href="/drain-advice">Blogs</a><a href="/about">About our team</a><a href="/services/pipe-relining">Relining & repair options</a></div></div><div class="wrap footer-bottom"><p>{site.name} is the Northern Beaches blocked-drain service from <a class="footer-operator" href="https://antonsplumbingandgas.com.au/">{site.operator}</a>. NSW contractor licence {site.licence}.<br />A mobile service; availability and access are confirmed for your address.</p><div><a href="/privacy">Privacy</a><a href="/terms">Service terms</a><span>© {new Date().getFullYear()} <a class="footer-operator" href="https://antonsplumbingandgas.com.au/">{site.operator}</a></span></div></div></footer>
  <a class="mobile-call" href={site.tel}><span>Blocked drain? Call the team</span><strong>{site.phone}</strong></a>
  <script>
    const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
    document.addEventListener('keydown', e => { if(e.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
    document.addEventListener('click', e => { if(menu?.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false; });
  </script>
</body></html>

<style>
 footer a.footer-operator{display:inline;margin:0;padding:0;color:inherit;font:inherit;text-decoration:underline;text-underline-offset:3px}
 footer a.footer-operator:focus-visible{outline:2px solid currentColor;outline-offset:3px}
</style>
