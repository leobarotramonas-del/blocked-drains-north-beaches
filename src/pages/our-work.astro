---
import ProjectShowcase from "../components/ProjectShowcase.astro";
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Cta from '../components/Cta.astro';
const gallery = [
  ['roots','Root mass removed during drainage work. Root removal restores space in the pipe; inspection helps assess the entry point.'],
  ['camera','CCTV equipment at an accessible drain opening. A clear view helps explain suitable next steps.'],
  ['jetting','A stocked service vehicle and drainage hose equipment at the job.'],
  ['bedded-pipe','Exposed pipework supported in prepared bedding before backfilling.'],
  ['junction','Drainage junctions and connections visible during installation.'],
  ['pipe-repair','Replacement drainage pipe and access fittings beside the property.'],
  ['excavation','Access to pipework during excavation and repair.'],
  ['finished-gully','A finished surface around a gully grate and inspection opening.'],
  ['stocked-truck','Tools and fittings organised in the plumbing service vehicle.'],
];
---
<Layout title="Blocked Drain Work | CCTV, Jetting & Pipe Repairs" description="See real drain work: root removal, CCTV inspections, pipe repairs and project videos. Explore equipment and methods used to diagnose and clear blocked drains." crumbs={[{name:'Our work',href:'/our-work'}]}>
  <div class="wrap intro-page"><h1>Real Work<br /><span class="blue">A Closer Look at the Capability</span></h1><p>From the obstruction we remove to the pipework we install, these photographs show practical drainage work by licensed plumbers.</p><p class="fine">A selection of work from across the plumbing service network. The photographs show work at different stages.</p></div><section class="wrap section" style="padding-top:0" aria-label="Drainage job photographs"><div class="gallery">{gallery.map(([name,caption])=><figure><Photo name={name} alt={caption} sizes="(max-width:760px) 45vw, 30vw" /><figcaption>{caption}</figcaption></figure>)}</div></section>
  <div class="wrap"><ProjectShowcase heading="Drainage projects across Sydney" items={["sewer-jetting", "sewer-clearing", "drain-overflow-response"]} /></div><Cta />
</Layout>
