---
import Layout from '../../layouts/Layout.astro';
import Cta from '../../components/Cta.astro';
import { areas, groups } from '../../data/areas';
---
<Layout title="Blocked Drain Service Areas | Northern Beaches" description="Find blocked-drain help across 45 Northern Beaches localities, from Manly and Dee Why to Palm Beach. Check local access advice and call to confirm availability." crumbs={[{name:'Service areas',href:'/service-areas'}]}>
  <div class="wrap intro-page"><h1>Across the Beaches<br /><span class="blue">Ready to Talk Drains</span></h1><p>Find your suburb for local booking information, drainage considerations and relevant services. We confirm the response and equipment access for your address when you call.</p></div>
  <section class="wrap section" style="padding-top:0"><div class="filter"><label for="area-search">Find your suburb</label><input type="search" id="area-search" placeholder="For example, Dee Why or Newport" autocomplete="off" /><p id="area-count" role="status">{areas.length} localities listed</p></div><div class="area-groups">{Object.entries(groups).map(([key,g])=><div class="area-group" data-area-group><h2 style="font-size:30px;margin-bottom:20px">{g.name}</h2><ul>{areas.filter(a=>a.group===key).map(a=><li data-area={a.name.toLowerCase()}><a href={`/service-areas/${a.slug}`}>{a.name}</a></li>)}</ul></div>)}</div><p id="no-results" class="no-results" hidden>No listed suburb matches. <a href="/contact">Call us to check your address</a>.</p><p class="coverage-note">For Cottage Point, Scotland Island, offshore bays and other restricted-access locations, call to discuss transport, equipment and access before arranging attendance.</p><p class="coverage-note">Our mobile team serves the areas listed above. Call with your full address to confirm availability, or explore <a href="https://www.northernbeaches.nsw.gov.au/council/about-northern-beaches-council/wards-and-suburbs">Northern Beaches Council’s suburb information</a>.</p></section><Cta />
  <script>
    const input = document.querySelector<HTMLInputElement>('#area-search');
    input?.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase(); let count = 0;
      document.querySelectorAll<HTMLElement>('[data-area]').forEach(el => { el.hidden = !el.dataset.area?.includes(query); if(!el.hidden) count++; });
      document.querySelectorAll<HTMLElement>('[data-area-group]').forEach(el => { el.hidden = !el.querySelector('[data-area]:not([hidden])'); });
      const status = document.querySelector('#area-count'); if(status) status.textContent = `${count} ${count===1 ? 'locality' : 'localities'} found`;
      const empty = document.querySelector<HTMLElement>('#no-results'); if(empty) empty.hidden = count>0;
    });
  </script>
</Layout>
