---
import ProjectShowcase from "../components/ProjectShowcase.astro";
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { areas, groups } from '../data/areas';
const featured = ['cctv-drain-inspections','high-pressure-water-jetting','tree-root-removal'];
---
<Layout title="Blocked Drains Northern Beaches | CCTV & Jetting" description="Blocked drains on the Northern Beaches? Call 0493 824 176 for CCTV, jetting, root removal and pipe repair. Licensed team, NSW 210933C. Urgent calls 24/7.">
  <section class="hero"><div class="hero-copy"><div class="google-review-badge" aria-label="Google reviews: five-star rated"><span class="google-word" aria-hidden="true"><span>G</span><span>o</span><span>o</span><span>g</span><span>l</span><span>e</span></span><span class="review-rating"><strong>5-Star Rated</strong><span class="review-stars" aria-hidden="true">{Array.from({ length: 5 }).map(() => <svg viewBox="0 0 24 24" focusable="false"><path d="m12 2.5 2.93 5.94 6.56.95-4.74 4.62 1.12 6.53L12 17.45l-5.87 3.09 1.12-6.53-4.74-4.62 6.56-.95L12 2.5Z" /></svg>)}</span></span></div><h1>Blocked Drains<br /><span>Clear Answers</span></h1><p>Antons Blocked Drains North Beaches provides drain clearing, camera inspections and repairs. We find the cause and explain the next step for your Northern Beaches property.</p><div class="actions"><a class="button call" href={site.tel}>Call {site.phone}</a><a class="text-link" href="#proof">See recent projects</a></div><ul class="hero-proof"><li>NSW licensed team</li><li>Real equipment. Real answers.</li></ul></div><figure class="hero-media"><Photo name="roots" alt="Drain technician holding a long root mass removed during drainage work" eager class="hero-main" /><Photo name="camera" alt="Technician inspecting a drain with CCTV equipment" class="hero-inset" sizes="(max-width: 760px) 128px, 190px" /><figcaption class="hero-caption"><span>Real roots removed during drainage work.</span><span>Inspect · Clear · Repair</span></figcaption></figure></section>
  <section class="urgent-strip"><div class="wrap"><div><strong>Sewage backing up right now?</strong><p>Stop using affected fixtures. Keep clear of wastewater. Call and describe what is happening.</p></div><a href="/services/emergency-blocked-drains">Get urgent help</a></div></section>
  <section class="section wrap" style="padding-top:0"><div class="section-heading"><h2>Equipped for More Than<br />a Temporary Fix</h2></div><div class="service-grid">{services.filter(s=>featured.includes(s.slug)).map(s=><a class="service-tile" href={`/services/${s.slug}`}><Photo name={s.image} alt={s.alt} sizes="(max-width:760px) calc((100vw - 54px) / 2), (max-width:1304px) calc((100vw - 120px) / 3), 395px" /><h3>{s.name}</h3><span class="link-label">Explore the service</span></a>)}</div><div class="service-index">{services.filter(s=>!featured.includes(s.slug)).map(s=><a href={`/services/${s.slug}`}><strong>{s.name}</strong><span>View service</span></a>)}</div></section>
  <div class="wrap"><ProjectShowcase heading="Recent drainage projects in the Northern Beaches and across Sydney" intro="Project footage and photographs from the Antons Plumbing &amp; Gas team across Sydney." items={["sewer-clearing", "drain-pipework-installation", "restricted-access-excavation"]} id="proof" /></div>
  <section class="section related"><div class="wrap"><div class="section-heading"><h2>Drain Help Across<br />the Northern Beaches</h2><p>Find your area, then call to confirm access and availability.</p></div><div class="area-groups">{Object.entries(groups).map(([key])=><div class="area-group"><ul>{areas.filter(a=>a.group===key).map(a=><li><a href={`/service-areas/${a.slug}`}>{a.name}</a></li>)}</ul></div>)}</div><p class="coverage-note">Offshore, island and water-access properties need a specific access check. <a href="/service-areas">Search all service areas</a>.</p></div></section>
  <section class="section wrap split"><div class="split-copy"><h2>Licensed Hands<br />Straightforward Advice</h2><p>Operated by {site.operator}, under NSW contractor licence {site.licence}. We assess the pipe, explain the findings and agree the proposed work.</p><a class="text-link" href="/about">Meet the team behind the service</a></div><div><blockquote class="quote">“David did exactly what he said he would, arrived on time, explained everything they did and showed me the results on the camera screen.”</blockquote><p class="quote-credit">Kristen P. · Customer review excerpt<br />Feedback about the wider plumbing team. Job location not specified.</p></div></section>
  <Cta />
</Layout>
